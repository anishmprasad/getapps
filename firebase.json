{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "sites/**",
        "tools/**",
        "supabase/**",
        "docs/**",
        "screenshots/**",
        "perfect_screenshot.png",
        "*.py"
      ],
      "rewrites": [
        {
          "source": "/about",
          "destination": "/about.html"
        },
        {
          "source": "/products",
          "destination": "/products.html"
        },
        {
          "source": "/contact",
          "destination": "/contact.html"
        },
        {
          "source": "/support",
          "destination": "/support.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/social/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, must-revalidate"
            }
          ]
        },
        {
          "source": "/@(favicon.ico|apple-touch-icon.png)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, must-revalidate"
            }
          ]
        },
        {
          "source": "/site.webmanifest",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "getinterest",
      "public": "sites/getinterest",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "/assets/social/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, must-revalidate"
            }
          ]
        },
        {
          "source": "/@(favicon.ico|apple-touch-icon.png)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, must-revalidate"
            }
          ]
        },
        {
          "source": "/site.webmanifest",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**/*.@(css|js|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },

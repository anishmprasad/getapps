{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "sites/**",
        "tools/**",
        "supabase/**",
        "docs/**",
        "screenshots/**",
        "*.py",
        "*.png"
      ],
      "rewrites": [
        { "source": "/about", "destination": "/about.html" },
        { "source": "/products", "destination": "/products.html" },
        { "source": "/contact", "destination": "/contact.html" },
        { "source": "/support", "destination": "/support.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "getinterest",
      "public": "sites/getinterest",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "/assets/**/*.@(css|js|svg)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "getpdf",
      "public": "sites/getpdf",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "/assets/vendor/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/assets/**/*.@(css|js|svg)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "getjson",
      "public": "sites/getjson",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "/assets/**/*.@(css|js|svg)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
